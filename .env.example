# Copy to .env (chmod 600) and fill in. Never commit .env.
# Docker Compose treats "$" in values as variable syntax: keep secrets alphanumeric
# (e.g. `openssl rand -hex 24`) so nothing needs escaping.

# --- Database (compose builds DATABASE_URL from this) ---
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# --- Access model ---
# Hostname(s) the app answers to, comma separated, no scheme, no port.
# This is the name Tailscale Serve gives the VM, e.g. srv-doc-01.tail1234.ts.net
ALLOWED_HOSTS=srv-doc-01.tail1234.ts.net

# Tailscale identity headers (Tailscale-User-Login) added by `tailscale serve`.
#   off     - ignore them
#   require - password login AND a matching Tailscale identity (recommended)
#   sso     - a matching Tailscale identity alone logs you in (users.tailscale_login must match)
TS_IDENTITY_MODE=require
# Tailscale login(s) allowed in, comma separated (your Tailscale account e-mail).
TS_ALLOWED_LOGINS=joren@example.com
# Only requests whose direct peer is in this list may supply identity headers.
# Must equal the gateway of the `web` network in docker-compose.yml.
TS_TRUSTED_PROXY_IPS=172.30.90.1/32

# --- Sessions ---
COOKIE_SECURE=true
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# --- Claude API (receipt reading) ---
# Create a dedicated key in the Anthropic Console with a monthly spend limit (about EUR 5), so this
# app can never spend more than that. Only the worker container uses it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# low | medium | high: how hard the model thinks per receipt (higher = slower and more expensive)
LLM_EFFORT=medium
# Shelf price labels are short and simple: a cheaper setting is enough. Try claude-haiku-4-5 later if you want
# to save more; check the readings in the `extractions` table first.
LLM_MODEL_SHELF=claude-sonnet-5
LLM_EFFORT_SHELF=low
# Open Food Facts asks for an identifier with a contact, e.g. GroceryAgent/0.1 (you@example.com)
OFF_USER_AGENT=GroceryAgent/0.1 (self-hosted)
# New receipts are not read once the estimated spend this month reaches this (alert shown at 80%).
LLM_MONTHLY_BUDGET_EUR=5

# --- Deals radar (weekly offers from PrijsProfeet, alerts through Home Assistant) ---
# Optional free key from prijsprofeet.nl/api (150 requests/min on the key instead of per IP). Works without.
PRIJSPROFEET_API_KEY=
# Alerts: the address of Home Assistant, a long-lived access token (profile page in HA) and the notify service of
# your phone, e.g. notify.mobile_app_joren_iphone. Leave empty to see the deals on the Deals page only.
HA_URL=
HA_TOKEN=
HA_NOTIFY_SERVICE=

# --- Overview ---
# The monthly food budget the overview compares against.
MONTHLY_REFERENCE_EUR=400

# --- Misc ---
LOG_LEVEL=INFO
